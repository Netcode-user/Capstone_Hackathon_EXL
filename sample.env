# --- LLM ---
# Leave blank to run in offline/template-fallback mode (still fully functional demo)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- Event bus ---
# mock  -> in-process pub/sub, no external services needed (default, best for demo/hackathon)
# kafka -> real Kafka, requires docker-compose up / a running broker
EVENT_BUS_MODE=mock
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PROCESS_EVENTS=process-events
KAFKA_TOPIC_DEVIATIONS=sop-deviations
KAFKA_TOPIC_SOP_UPDATES=sop-updates

# --- Embeddings / Vector store ---
EMBEDDING_DIM=384
VECTOR_STORE_DIR=./data/vector_store

# --- Deviation -> SOP evolution trigger ---
DEVIATION_WINDOW_SIZE=6
DEVIATION_TRIGGER_COUNT=3

# --- App ---
DATABASE_URL=sqlite:///./data/processgenome.db
APP_HOST=0.0.0.0
APP_PORT=8000
